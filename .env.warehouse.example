# Copy to .env.warehouse and fill in values from the Fabric Warehouse SQL endpoint.
# Do not commit .env.warehouse.

# Warehouse database name (SQL endpoint connection dialog → Database)
DB_NAME=YourWarehouseName

# Fabric Warehouse SQL endpoint host
DB_HOST=YOUR-WORKSPACE.datawarehouse.fabric.microsoft.com
DB_PORT=1433

# Fabric / Entra tenant ID
DB_TENANT=YOUR-TENANT-GUID

# ActiveDirectoryCli = az login token (recommended; works in Cursor terminal)
# ActiveDirectoryInteractive = browser login (run from Terminal.app if popup does not show)
DB_AUTH=ActiveDirectoryCli

# Optional: full connection string instead of DB_HOST + DB_NAME + DB_AUTH
# DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:...

# Optional: override local schema_scraper checkout
# SCHEMA_SCRAPER_DIR=/Users/you/code/schema_scraper
