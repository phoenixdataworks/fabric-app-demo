{
  "name": "fabric-app-demo",
  "description": "Read-only Fabric Data App demo: Migration Pulse queries a live semantic model over Demo DW via DAX.",
  "license": "MIT",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "test -f .env.fabric && cp .env.fabric .env.development.local || true",
    "dev": "vite",
    "build": "tsc -b --noCheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "npm run lint && npm test && npm run build",
    "fabric:generate": "node node_modules/@microsoft/fabric-app-data-cli/dist/index.js generate -o src/fabric.generated.ts",
    "skills:install": "bash scripts/install-skills-for-fabric.sh",
    "skills:list": "npx --yes skills list",
    "skills:list:global": "npx --yes skills list -g",
    "warehouse:sql": "tsx scripts/generate-warehouse-sql.ts",
    "schema:scrape": "bash scripts/scrape-warehouse-schema.sh"
  },
  "dependencies": {
    "@microsoft/fabric-app-data": "^1.0.0",
    "@microsoft/fabric-app-data-embed-client": "^1.0.0",
    "@microsoft/fabric-app-data-proxy": "^1.0.0",
    "@microsoft/fabric-datagrid": "0.0.10",
    "@microsoft/fabric-visuals": "0.0.9",
    "@microsoft/fabric-visuals-core": "0.0.9",
    "@microsoft/rayfin-auth-provider-fabric": "^1.32.0",
    "@microsoft/rayfin-client": "^1.32.0",
    "@tailwindcss/vite": "^4.2.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.2.5",
    "react-error-boundary": "^6.0.0",
    "react-router-dom": "^7.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@microsoft/fabric-app-data-cli": "^1.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "rollup-plugin-license": "^3.7.1",
    "tsx": "^4.20.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.2.6",
    "vitest": "^3.2.2"
  }
}
