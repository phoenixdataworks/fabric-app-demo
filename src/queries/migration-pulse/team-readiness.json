{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "title": {
    "text": "Migration readiness by team (weekly)",
    "fontSize": 14,
    "anchor": "start"
  },
  "data": { "name": "source" },
  "mark": { "type": "rect", "cornerRadiusEnd": 3 },
  "encoding": {
    "x": {
      "field": "week",
      "type": "ordinal",
      "title": null,
      "axis": { "labelAngle": 0 }
    },
    "y": { "field": "team", "type": "ordinal", "title": null, "sort": "-x" },
    "color": {
      "field": "readiness",
      "type": "quantitative",
      "title": "Score",
      "scale": { "scheme": "blues" },
      "legend": { "orient": "top", "gradientLength": 120 }
    },
    "tooltip": [
      { "field": "team", "type": "nominal" },
      { "field": "week", "type": "ordinal" },
      { "field": "readiness", "type": "quantitative", "format": ".0f" }
    ]
  },
  "config": {
    "view": { "stroke": null },
    "axis": { "grid": false }
  }
}
